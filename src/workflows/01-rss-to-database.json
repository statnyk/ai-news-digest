{
  "name": "01 — RSS Ingestion (Current App Pipeline)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 280]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 6 }]
        }
      },
      "id": "trigger-schedule",
      "name": "Schedule (Every 6h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ai-news-digest-production.up.railway.app/api/pipeline",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"range\":\"1w\"}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "run-pipeline",
      "name": "Run Pipeline API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 370]
    },
    {
      "parameters": {
        "jsCode": "const result = $json;\n\nreturn [{\n  json: {\n    message: `Pipeline finished. Ingested: ${result.ingested ?? 0}, Indexed chunks: ${result.indexed ?? 0}, Digest articles: ${result.digest?.articleCount ?? 0}`,\n    ingested: result.ingested ?? 0,\n    indexed: result.indexed ?? 0,\n    digestArticleCount: result.digest?.articleCount ?? 0,\n    stepErrors: result.stepErrors || [],\n    timestamp: new Date().toISOString(),\n    raw: result\n  }\n}];"
      },
      "id": "summary",
      "name": "Pipeline Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 370]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Run Pipeline API", "type": "main", "index": 0 }]] },
    "Schedule (Every 6h)": { "main": [[{ "node": "Run Pipeline API", "type": "main", "index": 0 }]] },
    "Run Pipeline API": { "main": [[{ "node": "Pipeline Summary", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "ai-news-digest" }]
}
