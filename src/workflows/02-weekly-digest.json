{
  "name": "02 — Weekly Digest (Current API)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * 1" }]
        }
      },
      "id": "trigger-weekly",
      "name": "Weekly (Mon 9AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 500]
    },
    {
      "parameters": {
        "url": "https://ai-news-digest-production.up.railway.app/api/digest?generate=true&range=1w",
        "options": {
          "timeout": 600000
        }
      },
      "id": "fetch-digest",
      "name": "Generate Digest via API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 400]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    message: `Digest generated. Articles: ${$json.articleCount ?? 0}`,\n    articleCount: $json.articleCount ?? 0,\n    markdown: $json.markdown || '',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "summary",
      "name": "Digest Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 400]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Generate Digest via API", "type": "main", "index": 0 }]] },
    "Weekly (Mon 9AM)": { "main": [[{ "node": "Generate Digest via API", "type": "main", "index": 0 }]] },
    "Generate Digest via API": { "main": [[{ "node": "Digest Summary", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "ai-news-digest" }]
}
