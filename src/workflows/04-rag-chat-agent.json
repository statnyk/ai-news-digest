{
  "name": "04 — RAG Chat Agent (Current API)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-news-chat",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "chat-webhook",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "ai-news-chat"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json.body || $json;\nconst message = payload.message || payload.question || payload.text || '';\n\nreturn [{\n  json: {\n    message,\n    topicSlug: payload.topicSlug || null\n  }\n}];"
      },
      "id": "normalize-input",
      "name": "Normalize Chat Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ai-news-digest-production.up.railway.app/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"message\": $json.message, \"topicSlug\": $json.topicSlug}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "call-chat-api",
      "name": "Call Chat API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    answer: $json.answer || \"No answer generated.\",\n    sources: $json.sources || [],\n    question: $json.question || null,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 300]
    }
  ],
  "connections": {
    "Chat Webhook": {
      "main": [[{ "node": "Normalize Chat Input", "type": "main", "index": 0 }]]
    },
    "Normalize Chat Input": {
      "main": [[{ "node": "Call Chat API", "type": "main", "index": 0 }]]
    },
    "Call Chat API": {
      "main": [[{ "node": "Format Response", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "ai-news-digest" }]
}
