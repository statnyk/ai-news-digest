{
  "name": "03 — Vector Indexing (Current App Pipeline)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 2 }]
        }
      },
      "id": "trigger-schedule",
      "name": "Schedule (Every 2h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ai-news-digest-production.up.railway.app/api/pipeline",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"range\":\"1d\"}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "run-pipeline",
      "name": "Run Pipeline API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 400]
    },
    {
      "parameters": {
        "jsCode": "const result = $json;\n\nreturn [{\n  json: {\n    message: `Pipeline finished. Indexed chunks: ${result.indexed ?? 0}`,\n    indexedChunks: result.indexed ?? 0,\n    ingested: result.ingested ?? 0,\n    digestArticleCount: result.digest?.articleCount ?? 0,\n    stepErrors: result.stepErrors || [],\n    note: 'Current app exposes indexing through /api/pipeline.',\n    timestamp: new Date().toISOString(),\n    raw: result\n  }\n}];"
      },
      "id": "summary",
      "name": "Indexing Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 400]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Run Pipeline API", "type": "main", "index": 0 }]] },
    "Schedule (Every 2h)": { "main": [[{ "node": "Run Pipeline API", "type": "main", "index": 0 }]] },
    "Run Pipeline API": { "main": [[{ "node": "Indexing Summary", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "ai-news-digest" }]
}
