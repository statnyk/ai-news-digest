# ─── Database (PostgreSQL) ───────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_news_digest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ─── Vector Store (Qdrant) ───────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=articles

# ─── OpenAI (Embeddings + LLM) ──────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── RSS Feed Sources ────────────────────────────────────────
RSS_FEEDS=https://techcrunch.com/category/artificial-intelligence/feed/,https://feeds.arstechnica.com/arstechnica/technology-lab,https://www.theverge.com/rss/ai-artificial-intelligence/index.xml

# ─── Digest Configuration ────────────────────────────────────
DIGEST_OUTPUT_DIR=./outputs
DIGEST_DAYS=7

# ─── RAG Configuration ───────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─── n8n (for workflow import) ───────────────────────────────
N8N_PORT=5678
