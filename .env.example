# ─── Database (PostgreSQL) ───────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_news_digest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ─── Vector Store (Qdrant) ───────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=articles

# ─── OpenAI (Embeddings + LLM) ──────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── RSS Feed Sources ────────────────────────────────────────
RSS_FEEDS=https://techcrunch.com/category/artificial-intelligence/feed/,https://feeds.arstechnica.com/arstechnica/technology-lab,https://www.theverge.com/rss/ai-artificial-intelligence/index.xml

# ─── Digest Configuration ────────────────────────────────────
DIGEST_OUTPUT_DIR=./outputs
DIGEST_DAYS=7

# ─── RAG Configuration ───────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─── n8n (UI port + PostgreSQL for n8n’s own data) ───────────
N8N_PORT=5678

# n8n uses a separate DB for workflows/executions/credentials. Create it once:
#   docker exec -it ai-news-postgres psql -U postgres -c "CREATE DATABASE n8n;"
# (Or start Postgres with scripts/postgres-init-n8n.sh in docker-entrypoint-initdb.d.)
# Connection variables for n8n’s database (set these on the n8n process/container):
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=changeme
