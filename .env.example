# ═══════════════════════════════════════════════════════════════
# База приложения (articles, topics, article_embeddings)
# Используется: App (API), миграции, в n8n — credential для воркфлоу
# ═══════════════════════════════════════════════════════════════
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_news_digest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Опционально: одна строка вместо пяти переменных (Railway и др.)
# DATABASE_URL=postgresql://user:password@host:port/database

# ═══════════════════════════════════════════════════════════════
# База n8n (воркфлоу, креды, запуски) — только для процесса n8n
# НЕ подставлять в App. В Railway — только у сервиса n8n
# ═══════════════════════════════════════════════════════════════
N8N_PORT=5678
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=changeme

# Локально: одна машина Postgres, две БД (ai_news_digest + n8n).
# Railway: у App — только POSTGRES_* на базу railway; у n8n — только DB_POSTGRESDB_* на базу n8n.

# ─── Vector Store (Qdrant) ───────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=articles

# ─── OpenAI (Embeddings + LLM) ──────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── RSS Feed Sources ────────────────────────────────────────
RSS_FEEDS=https://techcrunch.com/category/artificial-intelligence/feed/,https://feeds.arstechnica.com/arstechnica/technology-lab,https://www.theverge.com/rss/ai-artificial-intelligence/index.xml

# ─── Digest Configuration ────────────────────────────────────
DIGEST_OUTPUT_DIR=./outputs
DIGEST_DAYS=7

# ─── API / n8n (backend only) ─────────────────────────────────
# Backend forwards digest/chat to n8n when set. Frontend must NOT use this.
# N8N_WEBHOOK_BASE_URL=https://your-n8n.app/webhook

# Optional: frontend API base (Vite exposes VITE_* only). Empty = same origin / proxy.
# VITE_API_URL=

# ─── RAG Configuration ───────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
CHUNK_SIZE=500
CHUNK_OVERLAP=50
